# ─── Runtime ───
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ─── Database ───
DATABASE_URL=postgresql://fleet:fleet_dev_password@localhost:5432/fleet_tracking?schema=public
# For docker compose internal networking, backend uses:
# DATABASE_URL=postgresql://fleet:fleet_dev_password@postgres:5432/fleet_tracking?schema=public

# ─── Redis ───
REDIS_URL=redis://localhost:6379
# docker: redis://redis:6379

# ─── Auth ───
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Device ingestion ───
DEVICE_TCP_ENABLED=false
DEVICE_TCP_PORT=5023
DEVICE_UDP_ENABLED=false
DEVICE_UDP_PORT=5024
INGEST_MAX_SKEW_MINUTES=60
INGEST_MIN_MOVE_METERS=5

# ─── Trips ───
TRIP_MIN_DURATION_SECONDS=120
TRIP_MIN_DISTANCE_METERS=300

# ─── Simulator ───
SIMULATOR_DEFAULT_COUNT=5

# ─── Reports / jobs ───
BULLMQ_PREFIX=fleet
TELEMETRY_RETENTION_DAYS=365
